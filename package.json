{
  "name": "ics-calendar-toolkit",
  "version": "0.2.0",
  "description": "Build, read and validate `.ics` calendar feeds and keep subscribers from being notified about events that haven't changed.",
  "keywords": [
    "ics",
    "icalendar",
    "calendar",
    "feed",
    "rfc5545"
  ],
  "license": "MIT",
  "author": "Łukasz Wójcik",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lwojcik/ics-calendar-toolkit.git"
  },
  "bugs": "https://github.com/lwojcik/ics-calendar-toolkit/issues",
  "homepage": "https://github.com/lwojcik/ics-calendar-toolkit#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "husky",
    "commit": "cz",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "TZ=UTC vitest run",
    "test:coverage": "TZ=UTC vitest run --coverage",
    "prepublishOnly": "npm run build",
    "release": "HUSKY=0 GITHUB_TOKEN=$(gh auth token) release-it --no-increment --no-git.commit",
    "release:prepare": "scripts/release-prepare.sh"
  },
  "dependencies": {
    "ical.js": "2.2.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@lwojcik/eslint-config": "0.1.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "^10.15.0",
    "husky": "9.1.7",
    "prettier": "3.10.1",
    "release-it": "^21.1.2",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "5.1.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
